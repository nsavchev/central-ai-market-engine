[Unit]
Description=Central AI isolated staging bounded task worker (AI-08)
Wants=docker.service
After=docker.service
ConditionPathExists=/opt/central-ai/staging-ai08/docker-compose.ai06.yml

[Service]
Type=oneshot
WorkingDirectory=/opt/central-ai/staging-ai08
ExecStart=/usr/bin/docker compose --project-name ca-ai08-staging -f docker-compose.ai06.yml --profile ai06 run --rm --no-deps -e CENTRAL_SUPERVISED_SERVICE_ENABLED=YES ai06-worker
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
