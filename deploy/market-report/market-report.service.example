[Unit]
Description=Market Engine supplied-input report (disabled example)
ConditionPathExists=/etc/market-report/execution.authorized

[Service]
Type=oneshot
User=market-report
Group=market-report
WorkingDirectory=/opt/market-report/source
ExecStart=/usr/bin/env -i HOME=/var/lib/market-report PATH=/usr/bin:/bin /opt/market-report/venv/bin/python -B -m app.scan_cli /etc/market-report/input.json --combined-report --report-asof-now --max-age-calendar-days 3 --output /var/lib/market-report/latest-report.json
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/market-report
TimeoutStartSec=60
TimeoutStopSec=15
KillMode=control-group
Restart=no
